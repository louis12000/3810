<%- include("../partials/header") %>

<%
  const statusText =
    item.status === 'open' ? 'Open'
    : item.status === 'claimed' ? 'Claim pending'
    : 'Closed';
%>

<div class="page-heading">
  <div>
    <p class="eyebrow">
      <%= item.type === 'lost' ? 'LOST RECORD' : 'FOUND RECORD' %>
      · <%= String(item._id).slice(-6).toUpperCase() %>
    </p>
    <h1><%= item.title %></h1>
    <p>Created <%= formatDate(item.createdAt) %> · updated <%= formatDate(item.updatedAt) %></p>
  </div>
  <div class="heading-actions">
    <a class="btn" href="/items">← Back to list</a>
    <% if (canManage) { %>
      <a class="btn btn--primary" href="/items/<%= item._id %>/edit">Edit</a>
    <% } %>
  </div>
</div>

<div class="split-2">
  <section class="panel">
    <div class="panel-body">
      <div class="detail-art">
        <% if (item.imageUrl) { %>
          <img src="<%= item.imageUrl %>" alt="<%= item.title %>" />
        <% } else { %>
          <span class="thumb thumb--<%= item.type %>"><%= item.type === 'lost' ? 'LS' : 'LF' %></span>
        <% } %>
        <span class="mono"><%= String(item._id).slice(-6).toUpperCase() %></span>
      </div>

      <p class="detail-desc"><%= item.description || '(no description)' %></p>

      <% if (item.status !== 'open') { %>
        <div class="note-box">
          <h3>Claim / handling record</h3>
          <p class="muted">
            <%= item.claimedBy ? item.claimedBy.name : '(user no longer active)' %>
            on <%= formatDate(item.claimedAt) %>
          </p>
          <% if (item.claimMessage) { %>
            <p class="detail-desc"><%= item.claimMessage %></p>
          <% } %>
          <% if (item.status === 'closed') { %>
            <p class="muted">Confirmed on <%= formatDate(item.closedAt) %>.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Item details</h2>
      <%# 三種狀態一齊顯示：認領（未領／已領）、找尋（未找到／找到）、流程（open/claimed/closed） %>
      <span class="badge-group">
        <span class="badge badge--<%= item.claimStatus %>">
          <span class="badge-dot"></span><%= meta.claimStatusLabel[item.claimStatus] %>
        </span>
        <span class="badge badge--<%= item.searchStatus %>">
          <span class="badge-dot"></span><%= meta.searchStatusLabel[item.searchStatus] %>
        </span>
        <span class="badge badge--<%= item.status %>">
          <span class="badge-dot"></span><%= statusText %>
        </span>
      </span>
    </div>

    <div class="panel-body">
      <div class="facts">
        <div>
          <small>Category</small>
          <strong><%= meta.categoryLabel[item.category] %></strong>
        </div>
        <div>
          <small>Type</small>
          <strong><%= meta.typeLabel[item.type] %></strong>
        </div>
        <div>
          <small>Location</small>
          <strong><%= item.location || '—' %></strong>
        </div>
        <div>
          <small>Date</small>
          <strong><%= formatDay(item.occurredAt) %></strong>
        </div>
        <div>
          <small>Registered by</small>
          <strong><%= item.owner ? item.owner.name : '(created via REST API)' %></strong>
        </div>
        <div>
          <small>Status</small>
          <strong><%= statusText %></strong>
        </div>
        <%# 兩個新狀態的明細，和上面的badge內容一致 %>
        <div>
          <small>Claim status</small>
          <strong><%= meta.claimStatusLabel[item.claimStatus] %></strong>
        </div>
        <div>
          <small>Search status</small>
          <strong><%= meta.searchStatusLabel[item.searchStatus] %></strong>
        </div>
      </div>

      <% if (canManage) { %>
        <div class="status-switch">
          <p class="field-hint">Quick status change (owner / admin only)</p>
          <div class="form-actions">
            <form class="inline-form" method="post" action="/items/<%= item._id %>/claim-status">
              <input type="hidden" name="claimStatus" value="<%= item.claimStatus === 'claimed' ? 'unclaimed' : 'claimed' %>" />
              <button class="btn btn--sm" type="submit">
                <%= item.claimStatus === 'claimed' ? 'Mark as unclaimed' : 'Mark as claimed' %>
              </button>
            </form>
            <form class="inline-form" method="post" action="/items/<%= item._id %>/search-status">
              <input type="hidden" name="searchStatus" value="<%= item.searchStatus === 'found' ? 'unfound' : 'found' %>" />
              <button class="btn btn--sm" type="submit">
                <%= item.searchStatus === 'found' ? 'Mark as not found' : 'Mark as found' %>
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <% if (canClaim) { %>
        <form class="form-grid" method="post" action="/items/<%= item._id %>/claim">
          <div class="field">
            <label for="claimMessage">Message to the owner (optional)</label>
            <textarea
              id="claimMessage"
              name="claimMessage"
              rows="3"
              maxlength="500"
              placeholder="e.g. I handed it in at the library service desk on level 3 — bring your student card."
            ></textarea>
            <span class="field-hint">Once confirmed, this record becomes Closed.</span>
          </div>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">
              <%= item.type === 'lost' ? 'I found it / I have a lead' : 'This is mine' %>
            </button>
          </div>
        </form>
      <% } %>

      <% if (canManage) { %>
        <div class="form-actions">
          <% if (item.status === 'claimed') { %>
            <form class="inline-form" method="post" action="/items/<%= item._id %>/confirm">
              <button class="btn btn--primary" type="submit">Confirm handover</button>
            </form>
            <form class="inline-form" method="post" action="/items/<%= item._id %>/reopen">
              <button class="btn" type="submit">Reject / reopen</button>
            </form>
          <% } else if (item.status === 'closed') { %>
            <form class="inline-form" method="post" action="/items/<%= item._id %>/reopen">
              <button class="btn" type="submit">Reopen</button>
            </form>
          <% } %>
          <form
            class="inline-form"
            method="post"
            action="/items/<%= item._id %>/delete"
            data-confirm="Are you sure you want to delete this record? This cannot be undone."
          >
            <button class="btn btn--danger" type="submit">Delete record</button>
          </form>
        </div>
        <p class="field-hint">A confirmation dialog appears before deleting.</p>
      <% } %>

      <% if (!canManage && !canClaim) { %>
        <p class="muted">
          <% if (item.status === 'open') { %>
            This is your record — waiting for someone to claim it.
          <% } else { %>
            This record is already in progress.
          <% } %>
        </p>
      <% } %>
    </div>
  </section>
</div>

<%- include("../partials/footer") %>
